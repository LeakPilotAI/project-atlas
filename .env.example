# ======================
# Application
# ======================
APP_ENV=development
APP_NAME=ProjectAtlas
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ======================
# Database
# ======================
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://atlas:change-me@localhost:5432/atlas

TIMESCALE_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ======================
# Market Data
# ======================
AXIOM_API_KEY=
BIRDEYE_API_KEY=

# ======================
# Alerting
# ======================
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_IDS=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ======================
# Scanner
# ======================
SCAN_INTERVAL_SECONDS=45
MAX_CONCURRENT_MARKETS=50

# ======================
# Perp A+ Filters
# ======================
PERP_MIN_VOLUME_24H=15000
PERP_MIN_OPEN_INTEREST=30000
PERP_MIN_SETUP_SCORE=78
PERP_MIN_CONFIDENCE=70
PERP_MAX_ALERTS_PER_CYCLE=3
PERP_ALERT_COOLDOWN_MINUTES=90
PERP_REQUIRE_REGIME_ALIGN=true
PERP_ALLOWLIST_ENABLED=true
PERP_ALLOWLIST=BTC,ETH,SOL,ANIME,BANANA,WCT,RSR,SOPH,kFLOKI,TNSR,NOT

# ======================
# Perp micro coach v3.1
# ======================
PERP_MICRO_ENABLED=true
PERP_MICRO_PAPER_ENABLED=true
PERP_MICRO_ALL_MARKETS=true
PERP_MICRO_RISK_USD=1.0
PERP_MICRO_MAX_OPEN=6
PERP_MICRO_MAX_TRIGGERS_PER_DAY=999
PERP_MICRO_MIN_OI=75000
PERP_MICRO_MIN_VOL=150000
PERP_MICRO_RSI_LONG=28
PERP_MICRO_RSI_SHORT=72
PERP_MICRO_MIN_EXTENSION_PCT=1.4
PERP_MICRO_SCAN_SECONDS=90
PERP_MICRO_MIN_RR=1.8
PERP_MICRO_PREFER_MAJORS=true
PERP_MICRO_BLOCK_MEME_FOR_LIVE_STATS=true
PERP_MICRO_LIVE_MIN_TRADES=50
PERP_MICRO_LIVE_MIN_WINRATE=0.55
PERP_MICRO_LIVE_MIN_SUM_R=8.0
PERP_MICRO_MAJORS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE,SUI,LINK,AVAX,NEAR,APT,ARB,OP,LTC,BCH,ADA,DOT,ATOM,UNI,AAVE,MKR,CRV,LDO

MICRO_HEARTBEAT_ENABLED=true
MICRO_HEARTBEAT_HOURS=6.0
DAILY_PAPER_RECAP_ENABLED=true
DAILY_PAPER_RECAP_HOUR_ET=20
DAILY_PAPER_RECAP_MINUTE_ET=0

# ======================
# Quality Dip
# ======================
QUALITY_DIP_ENABLED=true
QUALITY_DIP_WATCHLIST=MSFT,AAPL,GOOGL,AMZN,META,NVDA,AVGO,TSLA,MU,ADBE,CRM,NOW,ORCL,INTU,V,MA,COST,WMT,HD,NFLX,UNH,LLY,JNJ,ABBV,PG,KO,JPM,BRK-B,SPY,QQQ,IWM,DIA,VTI,VOO,QQQM,XLK,XLF,XLV,SMH,GLD,IAU,GDX,SLV,SIL
QUALITY_DIP_THRESHOLD_PCT=25
QUALITY_DIP_HIGH_PRIORITY_PCT=30
QUALITY_DIP_SHORT_DROP_PCT=15
QUALITY_DIP_METALS_THRESHOLD_PCT=12
QUALITY_DIP_METALS_HIGH_PRIORITY_PCT=18
QUALITY_DIP_ADAPTIVE=true
QUALITY_DIP_ADAPTIVE_FLOOR_STOCK=15
QUALITY_DIP_ADAPTIVE_FLOOR_METAL=8
QUALITY_DIP_ADAPTIVE_CEILING_STOCK=40
QUALITY_DIP_ADAPTIVE_CEILING_METAL=25
QUALITY_DIP_SCAN_INTERVAL_MINUTES=60
QUALITY_DIP_COOLDOWN_HOURS=24

# ======================
# Day Trade
# ======================
DAY_TRADE_ENABLED=true
DAY_TRADE_WATCHLIST=MSFT,AAPL,GOOGL,AMZN,META,NVDA,TSLA,MU,ADBE,CRM,NOW,ORCL,INTU,SPY,QQQ,GLD,SLV
DAY_TRADE_GAP_LONG_PCT=1.5
DAY_TRADE_GAP_SHORT_PCT=2.0
DAY_TRADE_SCAN_SECONDS=60
DAY_TRADE_ALERT_COOLDOWN_MINUTES=15

# ======================
# Robinhood / Command Center
# ======================
ROBINHOOD_BRIEF_ENABLED=true
ROBINHOOD_BRIEF_HOUR_ET=8
ROBINHOOD_BRIEF_MINUTE_ET=0
ROBINHOOD_CORE_WATCHLIST=MSFT,AAPL,GOOGL,AMZN,META,NVDA,AVGO,V,MA,JPM,BRK-B,UNH,LLY,JNJ,PG,KO,COST,WMT,SPY,QQQ,VOO,VTI
ROBINHOOD_DIP_MIN_PCT=12
ROBINHOOD_MAX_NAMES_IN_BRIEF=8
COMMAND_CENTER_ENABLED=true
COMMAND_CENTER_HOUR_ET=8
COMMAND_CENTER_MINUTE_ET=0

# ======================
# Accumulation
# ======================
ACCUM_ENABLED=true
ACCUM_SCAN_MINUTES=15
ACCUM_SYMBOLS=MSFT,GOOGL,META,ORCL,NVDA,TSLA,IAU,INTU,ADBE,AVGO,GLD,NFLX,MU,SLV,GDX,SIL,CRM,NOW
BTC_ACCUM_ENABLED=true
BTC_ACCUM_LEVELS=60000,56000,52000,48000,42000,36000,30000
BTC_ACCUM_SCAN_MINUTES=15
BTC_ACCUM_COOLDOWN_HOURS=720