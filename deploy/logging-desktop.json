{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"plain": {"format": "%(asctime)s %(levelname)s %(name)s %(message)s"}},
  "handlers": {
    "operational": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "../logs/api.out.log", "maxBytes": 20971520,
      "backupCount": 3, "encoding": "utf-8", "formatter": "plain"
    },
    "server": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "../logs/api.err.log", "maxBytes": 20971520,
      "backupCount": 3, "encoding": "utf-8", "formatter": "plain"
    }
  },
  "root": {"handlers": ["operational"], "level": "INFO"},
  "loggers": {
    "uvicorn": {"handlers": ["server"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["operational"], "level": "INFO", "propagate": false}
  }
}
